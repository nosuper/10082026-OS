# Production stack variables - copy to docker/.env.prod (gitignored)
# or, better, let scripts/wizard-production.sh write it for you.

# The public hostname; also the Frappe site name, so the Host header
# routes to it with no extra config.
AURA_SITE=os.example.vn

# Host ports the reverse proxy forwards to. Dev owns 8000/9000/8080,
# so production takes its own trio.
AURA_WEB_PORT=8100
AURA_SOCKET_PORT=9100
AURA_VITE_PORT=8180

# Real secrets - generated by the wizard, never the dev defaults.
AURA_DB_ROOT_PW=
AURA_ADMIN_PW=
