# The bench, baked. Software only - never site state.
#
# `bench init` downloads Frappe, builds a virtualenv and pip-installs the
# framework. It is most of the ten minutes an e2e boot used to spend, it
# produces the same bytes every time, and it was being redone on every run
# because the volume it lands in is thrown away with the stack.
#
# **What is baked is software; what is created per run is state.** The
# disposable-site property is the thing this must not spend: no site, no
# database, no seeded rows, no auraos app clone. A run still creates its own
# site, installs the app from the repo under test, and destroys both. This
# image only means the framework underneath is already there.
#
# Docker seeds an empty named volume from the image at the mount point, so
# compose's bench-data volume comes up already holding this bench. The copy
# costs seconds; bench init cost minutes.
FROM frappe/bench:latest

USER frappe
WORKDIR /home/frappe

# python3.12: the image defaults to 3.14, which Frappe v15 does not support.
# --skip-redis-config-generation: redis is its own compose service and the
# bench image ships no redis-server, exactly as init.sh has always done.
RUN bench init \
      --skip-redis-config-generation \
      --frappe-branch version-15 \
      --python python3.12 \
      /home/frappe/frappe-bench

# A warm npm cache, from the lockfile that is under version control. The
# frontend build runs inside this container against the app clone, whose path
# does not exist at build time - so node_modules cannot be baked, but the
# packages behind them can. `npm ci` in the run then resolves from cache
# instead of the network.
#
# Copied rather than mounted on purpose: a lockfile is build input. If it
# changes, this layer rebuilds, which is the behaviour you want.
COPY --chown=frappe:frappe frontend-react/package.json frontend-react/package-lock.json /tmp/warm/
RUN cd /tmp/warm \
    && npm ci --no-audit --no-fund --prefer-offline \
    && rm -rf /tmp/warm/node_modules

CMD ["bash", "/workspace/repo/docker/init.sh"]
